# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Better Auth ───────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET="generate-a-random-secret-here"      # openssl rand -hex 32
BETTER_AUTH_URL="http://localhost:3000"                  # change if different port
BETTER_AUTH_API_KEY=""

# ── Neon Auth ─────────────────────────────────────────────────────────────────
VITE_NEON_AUTH_URL=""
NEON_AUTH_URL=""

# ── Google OAuth (console.cloud.google.com) ───────────────────────────────────
# Add http://localhost:3000 as authorized origin + http://localhost:3000/api/auth/callback/google as redirect
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Twitter / X OAuth 2.0 (developer.twitter.com) ───────────────────────────
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""

# ── SMTP (for password reset emails) ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password_here   # Google App Password — myaccount.google.com/apppasswords

# ── AudD audio fingerprinting (audd.io) ──────────────────────────────────────
AUDD_API_KEY=""

# ── Groq Whisper transcription (console.groq.com) ────────────────────────────
GROQ_API_KEY=""
